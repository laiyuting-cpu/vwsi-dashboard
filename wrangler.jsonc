// Cloudflare Workers（靜態網站）設定。2026-11 從 GitHub Pages 搬來。
// 建置：sh scripts/build-pages.sh → dist/；部署：npx wrangler deploy
// 網域 work.vwsicamp.com 在 Cloudflare 後台手動加（Settings → Domains & Routes），
// 不寫在這裡：自動產生的 build token 沒有網域權限，寫了會部署失敗。
{
  "name": "vwsi-dashboard",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./dist" },
  // 只用自己的網域，關掉 *.workers.dev 與預覽網址，避免繞過 Cloudflare Access
  "workers_dev": false,
  "preview_urls": false
}
